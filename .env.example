# EWF-ID Environment Variables
# Copy this file to .env.local and fill in the values

# ============================================================================
# Database (Neon.tech - Serverless Postgres)
# ============================================================================
AUTHDB_DATABASE=ewf_id
AUTHDB_USER=your_db_user
AUTHDB_PASSWORD=your_db_password
AUTHDB_WRITE=postgres://user:password@db.region.neon.tech/ewf_id?sslmode=require
AUTHDB_READ_1=postgres://user:password@db-read1.region.neon.tech/ewf_id?sslmode=require
AUTHDB_READ_2=postgres://user:password@db-read2.region.neon.tech/ewf_id?sslmode=require

# ============================================================================
# Better Auth Configuration
# ============================================================================
BETTER_AUTH_SECRET=your-32-character-secret-key-here-at-least
BETTER_AUTH_URL=http://localhost:3000
HOST_URL=http://localhost:3000

# ============================================================================
# Email (Resend - Transactional Email Service)
# ============================================================================
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=EWF-ID <noreply@id.ewf-stade.de>

# ============================================================================
# Analytics & Feature Flags (PostHog)
# ============================================================================
POSTHOG_API_KEY=phc_your_posthog_api_key
POSTHOG_PROJECT_ID=12345

# Client-side PostHog (exposed to browser)
VITE_POSTHOG_KEY=phc_your_posthog_api_key
VITE_POSTHOG_HOST=https://eu.posthog.com

# ============================================================================
# Logging & Tracing (Axiom)
# ============================================================================
AXIOM_TOKEN=xaat-your-axiom-token
AXIOM_DATASET=ewf-id

# OpenTelemetry (optional, for sending traces to Axiom)
OTEL_EXPORTER_OTLP_ENDPOINT=https://api.axiom.co/v1/traces
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer xaat-your-axiom-token,X-Axiom-Dataset=ewf-id

# ============================================================================
# CAPTCHA (Cloudflare Turnstile)
# ============================================================================
CLOUDFLARE_TURNSTILE_SECRET_KEY=0x4AAAAAAA...your_secret_key
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=0x4AAAAAAA...your_site_key

# ============================================================================
# School OIDC Providers
# ============================================================================

# Gymnasium Athenaeum Stade (IServ)
OIDC_ATHENAEUM_CLIENT_ID=your_client_id
OIDC_ATHENAEUM_CLIENT_SECRET=your_client_secret
OIDC_ATHENAEUM_ISSUER=https://athenaeum.iserv.de

# Vincent Lübeck Gymnasium (Moodle)
OIDC_VLG_CLIENT_ID=your_client_id
OIDC_VLG_CLIENT_SECRET=your_client_secret
OIDC_VLG_ISSUER=https://moodle.vlg-stade.de

# Integrierte Gesamtschule Stade (IServ)
OIDC_IGS_CLIENT_ID=your_client_id
OIDC_IGS_CLIENT_SECRET=your_client_secret
OIDC_IGS_ISSUER=https://igs-stade.iserv.de

# ============================================================================
# Feature Flags (Client-side)
# ============================================================================
VITE_ENABLE_MULTI_SESSION=false
VITE_ENABLE_BULK_OPERATIONS=false
VITE_ENABLE_CREATE_ADMIN=false
VITE_ENABLE_DEVICE_AUTH=true

# ============================================================================
# Environment
# ============================================================================
NODE_ENV=development
VITE_HOST_URL=http://localhost:3000
