# EWF-ID Environment Variables
# Copy this file to .env and fill in the values

# ==========================================
# DATABASE (Neon.tech PostgreSQL)
# ==========================================
AUTHDB_DATABASE=ewf_id
AUTHDB_USER=ewf_id_user
AUTHDB_PASSWORD=your-secure-password
AUTHDB_WRITE=ep-xxx.us-east-1.aws.neon.tech
AUTHDB_READ_1=ep-xxx-read.us-east-1.aws.neon.tech
AUTHDB_READ_2=ep-xxx-read.us-east-1.aws.neon.tech

# ==========================================
# BETTER AUTH
# ==========================================
# Secret key for signing sessions (min 32 characters)
BETTER_AUTH_SECRET=your-secret-key-min-32-characters-long
# URL where Better Auth is hosted
BETTER_AUTH_URL=http://localhost:3000
HOST_URL=http://localhost:3000

# ==========================================
# EMAIL (Resend)
# ==========================================
RESEND_API_KEY=re_xxxxx
RESEND_FROM_EMAIL=EWF-ID <noreply@id.ewf-stade.de>

# ==========================================
# ANALYTICS & FEATURE FLAGS (PostHog)
# ==========================================
POSTHOG_API_KEY=phc_xxxxx
POSTHOG_PROJECT_ID=xxxxx
VITE_POSTHOG_KEY=phc_xxxxx
VITE_POSTHOG_HOST=https://eu.posthog.com

# ==========================================
# LOGGING (Axiom)
# ==========================================
AXIOM_TOKEN=xaat-xxxxx
AXIOM_DATASET=ewf-id

# ==========================================
# CAPTCHA (Cloudflare Turnstile)
# ==========================================
CLOUDFLARE_TURNSTILE_SECRET_KEY=0x4xxxxx
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=0x4xxxxx

# ==========================================
# SCHOOL OIDC PROVIDERS
# ==========================================

# Athenaeum (IServ)
OIDC_ATHENAEUM_CLIENT_ID=placeholder
OIDC_ATHENAEUM_CLIENT_SECRET=placeholder
OIDC_ATHENAEUM_ISSUER=https://athenaeum.iserv.de

# VLG (Moodle)
OIDC_VLG_CLIENT_ID=placeholder
OIDC_VLG_CLIENT_SECRET=placeholder
OIDC_VLG_ISSUER=https://vlg.de

# IGS (IServ)
OIDC_IGS_CLIENT_ID=placeholder
OIDC_IGS_CLIENT_SECRET=placeholder
OIDC_IGS_ISSUER=https://igs.iserv.de

# ==========================================
# OPENTELEMETRY (Optional)
# ==========================================
OTEL_EXPORTER_OTLP_ENDPOINT=https://api.axiom.co/v1/traces
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer xaat-xxxxx,X-Axiom-Dataset=ewf-id

# ==========================================
# DEVELOPMENT
# ==========================================
NODE_ENV=development
